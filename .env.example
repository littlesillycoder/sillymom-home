# 複製這個檔案成 .env.local，填入自己的值。.env.local 不會進 git。
# 金鑰不要貼在 issue、PR 或對話裡。

# 執行環境：development（本機）、preview（PR 預覽）、demo（展示）、production（正式）
# 沒設定時當成 production（最嚴格）。本機開發請設 development。
APP_ENV=development

# ── Supabase（開發用專案 sillymom-home-dev）──
# 到 Supabase 後台 → 選專案 sillymom-home-dev

# Data API 頁面的「API URL」，去掉最後的 /rest/v1/，例如 https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key（Project Settings → API Keys 頁面，sb_publishable_ 開頭）。可以公開，受 Row Level Security 限制。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key（Project Settings → API Keys 頁面，按眼睛圖示或複製按鈕，sb_secret_ 開頭）。只能放伺服器端，會略過 Row Level Security，絕對不能公開。
SUPABASE_SECRET_KEY=

# ── 事件補處理 ──
# /internal/events/process、/internal/maintenance 的密碼，至少 32 個字元。沒設定時這兩個網址回 404（本機開發可以不設）。
# 產生方式：在終端機執行 openssl rand -base64 48
EVENTS_CRON_SECRET=

# ── 外部服務（#4）：金流、發票、簡訊、通知 ──
# 允許的值見 src/shared/config/regions.ts。開發、預覽、展示沒設定時用 mock；
# 正式環境一定要設定，而且不能是 mock。
PAYMENT_PROVIDER=mock
INVOICE_PROVIDER=mock
SMS_PROVIDER=mock
NOTIFY_PROVIDER=mock

# ── 資安（#6）──
# CSP：enforce（擋下）或 report-only（只回報）。沒設定時：本機擋下、預覽和展示只回報、正式擋下。
# 正式環境設成 report-only 會直接報錯。本機開發不用設。
# CSP_MODE=

# Cloudflare Turnstile（防機器人）。本機開發不用設，會用 Cloudflare 的測試金鑰（一定通過）。
# 正式環境一定要設，而且不能是測試金鑰。網站金鑰可以公開；密鑰只能放伺服器端。
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
